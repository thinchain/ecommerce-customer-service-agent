# API
API_HOST=127.0.0.1
API_PORT=8000

# OpenAI-compatible model service
OPENAI_BASE_URL=http://127.0.0.1:8001/v1
OPENAI_API_KEY=local-dev-key
QWEN_MODEL=qwen3.5-4b
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1200

# Storage; relative paths use the project root
DATA_DIR=data
# MEMORY_DB_PATH=data/memory.sqlite3
# COMMERCE_DB_PATH=data/commerce.sqlite3
# KNOWLEDGE_DB_PATH=data/knowledge.sqlite3
# CHROMA_PATH=data/chroma

# Business tools: local or mcp
DEMO_USER_ID=U00001
COMMERCE_TOOL_TRANSPORT=local

# Retrieval: fts or chroma
RAG_BACKEND=fts
# EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_API_KEY=local-dev-key

# Agent execution
AGENT_MAX_STEPS=4
AGENT_WORKER_STEPS=3
AGENT_MAX_HANDOFFS=4
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_SECONDS=600
AGENT_CONTEXT_BYTES=12000
AGENT_MAX_HISTORY_TURNS=50
AGENT_HANDOFF_REPORT_BYTES=6500
AGENT_MAX_CALLS_PER_RESPONSE=4
STRUCTURED_ROUTING=true
KEV_DIRECT_ROUTING=true
CATALOG_EVIDENCE_ENABLED=true
NATURAL_RESPONSE_ENABLED=true

# Model requests
MAX_ACTIVE_CHATS=2
MODEL_TIMEOUT_SECONDS=180
MODEL_RETRIES=1
MODEL_CIRCUIT_THRESHOLD=5
MODEL_CIRCUIT_COOLDOWN=30

# Optional Kev service
JEV_MODE=off
JEV_SCOPE_ENABLED=false
JEV_BASE_URL=http://127.0.0.1:8795/v1
JEV_MODEL=kev-4b
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=3
JEV_ADVICE_THRESHOLD=0.8
JEV_REJECT_THRESHOLD=0.8
