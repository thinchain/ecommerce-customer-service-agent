# Public template. Copy to .env; never commit real credentials or local paths.
# API launcher: python backend/run.py (reload enabled; use --no-reload to disable).
API_HOST=127.0.0.1
API_PORT=8000

# OpenAI-compatible model endpoint; local-dev-key is a development placeholder.
OPENAI_BASE_URL=http://127.0.0.1:8001/v1
OPENAI_API_KEY=local-dev-key
QWEN_MODEL=qwen3.5-4b
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1200

# Storage root; relative paths are resolved from the project root, independent of cwd.
# Set private absolute paths only in your ignored .env, never in this template.
DATA_DIR=data
# Optional per-store overrides take precedence over DATA_DIR.
# MEMORY_DB_PATH=data/memory.sqlite3
# COMMERCE_DB_PATH=data/commerce.sqlite3
# KNOWLEDGE_DB_PATH=data/knowledge.sqlite3
# CHROMA_PATH=data/chroma

# Agent: tool rounds, whole-turn timeout and conservative context byte budget
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_SECONDS=600
# Next.js build/start environment; keep longer than the backend turn budget.
AGENT_PROXY_TIMEOUT_MS=630000
AGENT_CONTEXT_BYTES=12000

# Ecommerce: local, single-user synthetic demo
DEMO_USER_ID=U00001
# local (in-process) or mcp (standard stdio client/server)
COMMERCE_TOOL_TRANSPORT=local

# Offline lexical retrieval by default. Set chroma and configure embeddings for vectors.
RAG_BACKEND=fts
# EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
# EMBEDDING_MODEL=your-multilingual-embedding-model
# EMBEDDING_API_KEY=local-dev-key

# LangGraph multi-agent budgets (AGENT_MAX_STEPS above now bounds the supervisor)
AGENT_WORKER_STEPS=3
AGENT_MAX_HANDOFFS=4
AGENT_MAX_TOOL_CALLS=16
# History is stored and trimmed as complete user/assistant turns.
AGENT_MAX_HISTORY_TURNS=50
AGENT_HANDOFF_REPORT_BYTES=6500
AGENT_MAX_CALLS_PER_RESPONSE=4

# Portfolio dataset (after scripts/build_dataset.py)
# COMMERCE_DB_PATH=data/portfolio/commerce.sqlite3
# KNOWLEDGE_DB_PATH=data/portfolio/knowledge.sqlite3

# Model dependency protection / admission (per API process)
MAX_ACTIVE_CHATS=2
MODEL_TIMEOUT_SECONDS=180
MODEL_RETRIES=1
MODEL_CIRCUIT_THRESHOLD=5
MODEL_CIRCUIT_COOLDOWN=30

# Optional Kev service. Enable scope admission only after deploying/configuring it.
JEV_MODE=off
# Scope admission is independent of routing shadow/advisory. When enabled,
# Kev errors block non-greeting requests instead of falling through to Qwen.
JEV_SCOPE_ENABLED=false
STRUCTURED_ROUTING=true
KEV_DIRECT_ROUTING=true
# Let the model phrase verified business evidence for the customer.
NATURAL_RESPONSE_ENABLED=true
JEV_ADVICE_THRESHOLD=0.8
JEV_REJECT_THRESHOLD=0.8
JEV_MODEL=kev-4b
# JEV_API_KEY=

# Optional local model hosting. These are not required to use an existing endpoint.
# Set private paths in .env or .env.model.local, or export them in your shell.
# VLLM_ENV=/absolute/path/to/vllm-environment
# CUDA_VISIBLE_DEVICES=0
# MODEL_PATH=/absolute/path/to/qwen-checkpoint
MODEL_GPU_MEMORY_UTILIZATION=0.40
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=1
KV_CACHE_MEMORY_BYTES=1536M
# KEV_SOURCE_PATH=/absolute/path/to/kev-adapter
# KEV_BASE_PATH=/absolute/path/to/kev-base
# KEV_CHECKPOINT_PATH=/absolute/path/to/exported-kev
KEV_MODEL=kev-4b
KEV_GPU_MEMORY_UTILIZATION=0.30
KEV_MAX_MODEL_LEN=4096
KEV_MAX_NUM_SEQS=4
JEV_BASE_URL=http://127.0.0.1:8795/v1
JEV_TIMEOUT_SECONDS=3

# Catalog values are server-rendered from validated evidence; false is legacy A/B only.
CATALOG_EVIDENCE_ENABLED=true
