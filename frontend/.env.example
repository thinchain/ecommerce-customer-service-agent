# Backend connection for the Next.js server; never use NEXT_PUBLIC_ for credentials.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Internal citations, tool and agent details appear in collapsed panels.
# Set false to hide these panels. Restart next dev after changing this;
# production builds require rebuilding to change NEXT_PUBLIC variables.
NEXT_PUBLIC_SHOW_DEV_DETAILS=true
